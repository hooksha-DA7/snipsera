<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Snipsera</AssemblyName>
    <Product>Snipsera</Product>
    <Title>Snipsera</Title>
    <Company>hooksha-DA7</Company>
    <ApplicationIcon>Assets/Snipsera.ico</ApplicationIcon>
    <RootNamespace>Framelet</RootNamespace>
    <Version>1.0.6</Version>
    <InformationalVersion>1.0.6-preview.2</InformationalVersion>
    <Description>Screenshots, annotations and screen recording for Windows 11.</Description>
    <!-- WPF owns DPI via the manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ScreenRecorderLib" Version="7.0.1" /></ItemGroup>
  <ItemGroup><Content Include="../../.tools/recording-encoder/runtime/**/*" Link="encoder/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/Snipsera.ico" LogicalName="Snipsera.Icon.App" />
    <EmbeddedResource Include="Assets/Snipsera-Tray.ico" LogicalName="Snipsera.Icon.Tray" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Framelet.Checks" /></ItemGroup>
</Project>
