<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Framelet</AssemblyName>
    <RootNamespace>Framelet</RootNamespace>
    <Version>0.7.0</Version>
    <InformationalVersion>0.7.0-preview.1</InformationalVersion>
    <Description>Local screenshot capture, floating previews and history for Windows.</Description>
    <!-- WPF owns DPI via the manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ScreenRecorderLib" Version="7.0.1" /></ItemGroup>
  <ItemGroup><Content Include="../../.tools/recording-encoder/runtime/**/*" Link="encoder/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Framelet.Checks" /></ItemGroup>
</Project>
